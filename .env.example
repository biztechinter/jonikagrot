# Jonik Ndovu Farm Environment Variables Template

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Session & Security Secret
SESSION_SECRET=your_super_secret_session_key_minimum_32_characters

# Optional Supabase Integration (Drop-in production database & private document storage)
# If left empty, the application automatically runs in Local Persistent Mode using server-storage/
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-do-not-expose

# Email Dispatcher (Optional SMTP / Resend for access notifications)
RESEND_API_KEY=re_your_api_key
ADMIN_NOTIFICATION_EMAIL=investor.relations@jonikndovufarm.com
